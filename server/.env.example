# Copie ce fichier en ".env" (dans le dossier server) puis adapte si besoin.

# Port de l'API (et du site une fois construit)
PORT=4000

# Base MongoDB.
# - MongoDB installé sur le PC du cabinet (par défaut) :
MONGODB_URI=mongodb://127.0.0.1:27017/vet-site
# - Ou MongoDB Atlas (en ligne) : colle ici l'adresse fournie par Atlas, par exemple
#   mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/nom-du-client

# Clé secrète des sessions. Laisse vide : le serveur en génère une et la garde dans la base.
# JWT_SECRET=

# Mets true uniquement si le site est servi en HTTPS (mise en ligne).
COOKIE_SECURE=false

# Mise en ligne chez un hébergeur (Render, Railway, Azure…) : mets 1
# TRUST_PROXY=1

# Mise en ligne : dossier des radios et images. Il doit se trouver sur un DISQUE PERSISTANT de l'hébergeur,
# sinon les radios sont perdues à chaque redémarrage. Exemple : UPLOADS_DIR=/data/uploads
# UPLOADS_DIR=

# --- Notifications au vétérinaire (facultatif) ---
# Chaque jour, un message Telegram prévient le vétérinaire des rappels de vaccin qui arrivent,
# pour qu'il les envoie aux clients sur WhatsApp. Laisse vide pour désactiver.
# 1. Dans Telegram, cherche @BotFather, envoie /newbot et copie le jeton ici.
# 2. Envoie un message à ton bot, puis ouvre https://api.telegram.org/bot<JETON>/getUpdates
#    et copie le nombre "id" qui suit "chat".
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Heure d'envoi (0 à 23) et nombre de jours avant la date du rappel
# NOTIFY_HOUR=8
# NOTIFY_DAYS_BEFORE=3
