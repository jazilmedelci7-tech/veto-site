{
  "name": "site-veterinaire-modele",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "server": "npm run dev --prefix server",
    "dev:all": "concurrently -n site,api -c blue,green \"npm run dev\" \"npm run server\"",
    "install:all": "npm install && npm install --prefix server",
    "build:all": "npm run build && npm run build --prefix server",
    "start": "npm run start --prefix server",
    "deploy:build": "npm install --include=dev && npm install --include=dev --prefix server && npm run build:all"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "5.9.3",
    "vite": "^5.4.2",
    "concurrently": "^9.1.0"
  }
}
